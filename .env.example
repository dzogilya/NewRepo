# База даних PostgreSQL
POSTGRES_DB=fractals_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Рядки підключення
ConnectionStrings__Database=Host=postgres;Port=5432;Database=fractals_db;Username=postgres;Password=postgres_secure_password
ConnectionStrings__Redis=redis:6379

# Авторизація та безпека
Jwt__Secret=SuperSecretLongSecureKeyForJwtTokens1234567890!@#$
Jwt__Issuer=Fractals.Api
Jwt__Audience=Fractals.Client
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePassword123!

# Ліміти обчислень
CalculationLimits__MaxCost=500000000
CalculationLimits__MaxWidth=3000
CalculationLimits__MaxHeight=3000
CalculationLimits__MaxIterations=5000
CalculationLimits__MaxActivePerUser=2
CalculationLimits__MaxHistoryPerUser=30
CalculationLimits__MaxQueueLength=100
CalculationLimits__MaxTaskSeconds=120

# Налаштування AppServer
APP_CONCURRENCY=2
APP_CPU_THREADS=2

# Автомасштабування
MIN_APP_SERVERS=2
MAX_APP_SERVERS=6
SCALE_UP_QUEUE_THRESHOLD=2
SCALE_DOWN_IDLE_SECONDS=30
