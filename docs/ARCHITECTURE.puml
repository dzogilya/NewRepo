@startuml HeatLab_архітектура
title HeatLab — загальна архітектура системи
skinparam componentStyle rectangle
skinparam shadowing false

actor "Користувач" as User
actor "Адміністратор" as Admin

node "Браузер (клієнт)" {
  component "login.html — вхід / реєстрація\nindex.html — задачі, прогрес, результат\nadmin.html — моніторинг\n(HTML + JavaScript, перевірка полів)" as Front
}

node "Шлюз = веб-сервер + load balancer\nHeatLab.exe, https://localhost:7443" as Gateway {
  component "HTTPS (Kestrel)\nHTTP→HTTPS 301, HSTS" as Https
  component "Авторизація\nAuthController\ncookie HttpOnly + Secure" as Auth
  component "Задачі\nTasksController\nліміти, історія, скасування" as Tasks
  component "Адмін-панель\nAdminController" as AdminApi
  component "Balancer\nвибір вільного сервера,\nчерга + час очікування,\nвідмова, масштабування" as Balancer
}

node "Сервери застосувань — окремі процеси HeatLab.exe" as Servers {
  component "server-1 :5101\n(базовий)" as S1
  component "server-2 :5102\n(базовий)" as S2
  component "server-3 :5103\n(запускається автоматично)" as S3
  component "server-4 :5104\n(запускається автоматично)" as S4
}

database "База даних SQLite\nstorage/heatlab.sqlite" as Db {
  component "Users\nкористувачі, хеші паролів, ролі" as TUsers
  component "Tasks\nчерга, стан, прогрес,\nсервер, результат" as TTasks
}

User --> Front
Admin --> Front
Front --> Https : HTTPS-запити /api/*\n(опитування щосекунди)
Https --> Auth
Https --> Tasks
Https --> AdminApi
Tasks --> Balancer : нова задача
AdminApi --> Balancer : стан і навантаження серверів

Balancer --> S1 : POST /run/{id}
Balancer --> S2 : POST /run/{id}
Balancer --> S3 : POST /run/{id}
Balancer --> S4 : POST /run/{id}

Auth --> TUsers
Tasks --> TTasks
Balancer --> TTasks : призначає задачу серверу
S1 --> TTasks : прогрес, результат
S2 --> TTasks : прогрес, результат
S3 --> TTasks : прогрес, результат
S4 --> TTasks : прогрес, результат

note right of Balancer
  <b>Правило балансування</b> (без Round Robin):
  1. server-1 вільний → задача йому
  2. зайнятий → перенаправлення на server-2
  3. усі зайняті → запуск server-3, server-4 (максимум 4)
  4. і ті зайняті → черга (до 4) з позицією і часом очікування
  5. черга заповнена → відмова у виконанні (503)
  Додатковий сервер, що простоює 30 с, вимикається.
end note

note bottom of Servers
  Кожен сервер рахує одну задачу за раз (метод Якобі),
  кожні 0.5 с пише прогрес у БД і перевіряє скасування.
  Ліміти: N·N·K ≤ 2·10¹⁰, 120 с на задачу.
end note
@enduml
